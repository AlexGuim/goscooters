# Copiar para .env.local e preencher. O .env.local nunca é commitado.

# ── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de administração. NUNCA prefixar com NEXT_PUBLIC_: ignora o RLS e,
# exposta ao browser, dá acesso total à base de dados.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ─────────────────────────────────────────────────────────────────
WHATSAPP_NUMERO=351912345678

# Endereço público do site. Usado nos URLs canónicos e nas etiquetas hreflang,
# que os motores de busca exigem absolutos. Em produção: https://o-teu-dominio.pt
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Emails autorizados a entrar na administração e destinatários dos avisos de
# novo pedido. Aceita vários separados por vírgula.
# Se ficar vazio, NINGUÉM entra na administração (falha fechado, de propósito).
ADMIN_EMAIL=

# ── Notificações de novo pedido (ambas opcionais) ────────────────────────
# Sem estas variáveis o canal respectivo é simplesmente saltado e a aplicação
# continua a funcionar normalmente.

# Email — https://resend.com (free tier: 3.000 emails/mês)
RESEND_API_KEY=
# Remetente. Só se pode usar um domínio próprio depois de o verificar no Resend;
# até lá, onboarding@resend.dev funciona para testes.
RESEND_FROM=onboarding@resend.dev

# Telegram — criar um bot com @BotFather para obter o token.
# Para o chat id: enviar uma mensagem ao bot e abrir
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Lembretes de pagamento por SMS (rotina diária) ───────────────────────
# SMS via Twilio (https://twilio.com). Sem estas variáveis os lembretes SMS
# são saltados; o resumo por email (Resend) continua a funcionar.
#   ACCOUNT_SID e AUTH_TOKEN: no painel do Twilio (Account Info).
#   FROM: um número Twilio comprado, em E.164 (+1..., +351...), ou um
#         sender ID alfanumérico aprovado (ex.: "GoScooters").
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Segredo que protege o endpoint da rotina diária (/api/cron/lembretes).
# Gera um valor aleatório (ex.: openssl rand -hex 16). O Vercel Cron envia-o
# automaticamente no cabeçalho Authorization quando esta variável existe.
CRON_SECRET=

# Leitura automática dos documentos do motorista com o Gemini 2.5 Flash (visão).
# Chave em https://aistudio.google.com/apikey (Google AI Studio). É SÓ do
# servidor — nunca prefixar NEXT_PUBLIC. Sem ela, o formulário recorre ao OCR
# do browser (Tesseract), menos fiável. ~0,05 cêntimos por documento.
GEMINI_API_KEY=
